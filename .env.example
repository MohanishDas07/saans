# ---------------------------------------------------------------------------
# SAANS - Clean Air Assistant Environment Configuration
# ---------------------------------------------------------------------------

# Environment Mode: development / production
SAANS_ENV=development

# LLM Provider Key (Optional for Milestone 1; MockLLM available offline)
LLM_API_KEY=mock-dev-key

# Upstream Air Quality API (Open-Meteo default, no key needed)
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1

# Cache directory for SQLite responses & local pre-embedded index
CACHE_DIR=./apps/api/data

# Offline Force Flag (Set to 1 to run completely offline against labeled fixtures)
SAANS_OFFLINE=0

# Frontend public API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
